{
  "name": "video-platform",
  "version": "1.0.0",
  "private": true,
  "description": "YouTube-like video platform",
  "scripts": {
    "lint": "eslint backend/ frontend/js/ desktop/js/",
    "lint:fix": "eslint backend/ frontend/js/ desktop/js/ --fix",
    "format": "prettier --write \"backend/**/*.js\" \"frontend/js/**/*.js\" \"desktop/js/**/*.js\" \"frontend/css/**/*.css\"",
    "format:check": "prettier --check \"backend/**/*.js\" \"frontend/js/**/*.js\" \"desktop/js/**/*.js\" \"frontend/css/**/*.css\"",
    "test": "cd backend && npm test",
    "test:coverage": "cd backend && npm run test:coverage",
    "test:frontend": "npx jest frontend/__tests__/ --passWithNoTests",
    "build": "node scripts/build.js",
    "build:css": "node scripts/build-css.js",
    "build:js": "node scripts/build-js.js",
    "build:html": "node scripts/build-html.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "csso-cli": "^4.0.2",
    "eslint": "^8.57.0",
    "html-minifier": "^4.0.0",
    "husky": "^9.1.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "terser": "^5.51.2"
  },
  "lint-staged": {
    "backend/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "frontend/js/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "desktop/js/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "frontend/css/**/*.css": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  }
}
