{
  "env": {
    "node": true,
    "commonjs": true,
    "browser": true,
    "es2021": true
  },
  "globals": {
    "API": "readonly",
    "currentSection": "writable",
    "currentPage": "writable",
    "itemsPerPage": "writable",
    "searchQuery": "writable",
    "editingId": "writable",
    "editingType": "writable",
    "categoriesCache": "writable",
    "channelsCache": "writable",
    "deleteTarget": "writable",
    "detectPlatform": "readonly",
    "getPlatformBadgeClass": "readonly",
    "getPlatformName": "readonly",
    "escapeHtml": "readonly",
    "formatNumber": "readonly",
    "formatDate": "readonly",
    "showToast": "readonly",
    "showLoading": "readonly",
    "hideLoading": "readonly",
    "openModal": "readonly",
    "closeModal": "readonly",
    "navigateTo": "readonly",
    "loadSection": "readonly",
    "loadDashboard": "readonly",
    "loadVideos": "readonly",
    "loadCategories": "readonly",
    "loadChannels": "readonly",
    "loadAddVideo": "readonly",
    "handleVideoUrlChange": "readonly",
    "handleThumbnailChange": "readonly",
    "saveVideo": "readonly",
    "editVideo": "readonly",
    "handleSearch": "readonly",
    "changePage": "readonly",
    "generatePagination": "readonly",
    "confirmDelete": "readonly",
    "executeDelete": "readonly",
    "openCategoryModal": "readonly",
    "editCategory": "readonly",
    "saveCategory": "readonly",
    "openChannelModal": "readonly",
    "editChannel": "readonly",
    "saveChannel": "readonly",
    "checkConnection": "readonly"
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-console": "off",
    "eqeqeq": "off",
    "no-var": "off",
    "prefer-const": "off",
    "no-undef": "off"
  }
}
